<?php

declare(strict_types=1);

namespace Database\Factories;

use App\Enums\TransactionStatus;
use App\Enums\TransactionType;
use App\Models\Account;
use App\Models\Category;
use App\Models\Payee;
use App\Models\Transaction;
use App\Models\User;
use Illuminate\Database\Eloquent\Factories\Factory;

/**
 * @extends Factory<Transaction>
 */
class TransactionFactory extends Factory
{
    protected $model = Transaction::class;

    /**
     * @return array<string, mixed>
     */
    public function definition(): array
    {
        return [
            'user_id' => User::factory(),
            'type' => TransactionType::Expense,
            'account_id' => null,
            'transfer_account_id' => null,
            'credit_card_id' => null,
            'invoice_id' => null,
            'amount_cents' => fake()->numberBetween(1000, 60000),
            'currency' => 'BRL',
            'date' => fake()->dateTimeBetween('-2 months', 'now')->format('Y-m-d'),
            'competence_date' => null,
            'description' => fake()->randomElement([
                'Compra no iFood',
                'Corrida Uber',
                'Conta de Luz',
                'Aluguel',
                'Supermercado',
                'Farmácia',
                'Conta de Água',
                'Internet',
                'Academia',
                'Restaurante',
                'Padaria',
                'Combustível',
                'Salário',
                'Freelance',
            ]),
            'notes' => null,
            'payee_id' => null,
            'category_id' => null,
            'status' => TransactionStatus::Cleared,
            'recurrence_id' => null,
            'recurrence_occurrence_date' => null,
            'is_detached' => false,
            'installment_group_id' => null,
            'installment_number' => null,
            'installment_total' => null,
            'is_ignored_in_reports' => false,
            'external_id' => null,
            'import_batch_id' => null,
        ];
    }

    /**
     * Transação de um usuário específico (sem criar usuário extra).
     */
    public function forUser(?User $user = null): static
    {
        return $this->state(fn (array $attributes): array => [
            'user_id' => $user?->getKey() ?? User::factory(),
        ]);
    }

    /**
     * Lançamento em uma conta específica.
     */
    public function forAccount(?Account $account = null): static
    {
        return $this->state(fn (array $attributes): array => [
            'account_id' => $account?->getKey() ?? Account::factory(),
        ]);
    }

    public function forCategory(?Category $category = null): static
    {
        return $this->state(fn (array $attributes): array => [
            'category_id' => $category?->getKey() ?? Category::factory(),
        ]);
    }

    public function forPayee(?Payee $payee = null): static
    {
        return $this->state(fn (array $attributes): array => [
            'payee_id' => $payee?->getKey() ?? Payee::factory(),
        ]);
    }

    /**
     * Transferência single-row (SPEC 3.9): uma linha com origem + destino.
     */
    public function transfer(Account $from, Account $to, int $cents): static
    {
        return $this->state(fn (array $attributes): array => [
            'type' => TransactionType::Transfer,
            'account_id' => $from->getKey(),
            'transfer_account_id' => $to->getKey(),
            'amount_cents' => $cents,
        ]);
    }

    public function income(int $cents): static
    {
        return $this->state(fn (array $attributes): array => [
            'type' => TransactionType::Income,
            'amount_cents' => $cents,
        ]);
    }

    public function expense(int $cents): static
    {
        return $this->state(fn (array $attributes): array => [
            'type' => TransactionType::Expense,
            'amount_cents' => $cents,
        ]);
    }

    public function pending(): static
    {
        return $this->state(fn (array $attributes): array => [
            'status' => TransactionStatus::Pending,
        ]);
    }

    public function cleared(): static
    {
        return $this->state(fn (array $attributes): array => [
            'status' => TransactionStatus::Cleared,
        ]);
    }

    public function reconciled(): static
    {
        return $this->state(fn (array $attributes): array => [
            'status' => TransactionStatus::Reconciled,
        ]);
    }

    public function ignored(): static
    {
        return $this->state(fn (array $attributes): array => [
            'is_ignored_in_reports' => true,
        ]);
    }
}
