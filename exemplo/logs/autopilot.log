<?php

declare(strict_types=1);

namespace App\Models\Concerns;

use App\Models\User;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\BelongsTo;
use Illuminate\Support\Facades\Auth;

/**
 * Infra multiusuário (SPEC 2.17) para models com coluna `user_id`.
 * Aplica o CurrentUserScope, preenche `user_id` no creating quando
 * houver usuário autenticado e expõe a relação user().
 *
 * Fica em App\Models\Concerns (e não em App\Domain) por ser infra de
 * persistência do Eloquent, não regra de negócio: mantém o domínio
 * livre de acoplamento com o framework.
 */
trait BelongsToUser
{
    protected static function bootBelongsToUser(): void
    {
        static::addGlobalScope(new CurrentUserScope);

        static::creating(static function (Model $model): void {
            if ($model->getAttribute('user_id') !== null) {
                return;
            }

            $userId = Auth::id();

            if ($userId !== null) {
                $model->setAttribute('user_id', $userId);
            }
        });
    }

    /**
     * @return BelongsTo<User, $this>
     */
    public function user(): BelongsTo
    {
        return $this->belongsTo(User::class);
    }
}
